# Local Shared Space — PostgreSQL (inside Docker)

# The app (custom Next.js server with WebSocket)
HOST=0.0.0.0
PORT=3000

# Hostname/devices on the LAN reach the host via this address
LAN_URL=http://localhost:3000

# PostgreSQL connection (matches docker-compose.yml below)
DATABASE_URL=postgresql://localshare:localshare@localhost:5432/localshare

# Where uploaded files are stored on the host filesystem
STORAGE_DIR=./storage/shared-files

# Max upload size in bytes (default 2 GB)
MAX_UPLOAD_BYTES=2147483648