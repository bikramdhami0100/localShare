{
  "name": "local-share",
  "version": "1.0.0",
  "private": true,
  "description": "Local Wi-Fi / LAN shared content platform. No login, real-time sharing, persistent shared data. PostgreSQL + Next.js.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node database/migrate.mjs",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "^14.2.21",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}